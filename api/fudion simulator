# =========================================================
# OUTPUT DIRECTORY
# =========================================================
OUTPUT_DIR = "detected_heatmaps"

os.makedirs(
    OUTPUT_DIR,
    exist_ok=True
)

# =========================================================
# LOAD CNN MODEL
# =========================================================
BASE_DIR = Path(__file__).resolve().parent.parent

MODEL_PATH = BASE_DIR / "models" / "final_model.keras"

MODEL = tf.keras.models.load_model(MODEL_PATH)

CLASS_NAMES = [
    "k",
    "n",
    "p",
    "healthy",
    "not_cacao"
]

print("✅ CNN MODEL LOADED")

# =========================================================
# HYBRID FUSION WEIGHTS
# =========================================================
ALPHA = 0.7
BETA = 0.3

# =========================================================
# WEBSOCKET CLIENTS
# =========================================================
clients: set[WebSocket] = set()

# =========================================================
# LIVE SENSOR DATA
# =========================================================
latest_sensor = {
    "n": 70,
    "p": 70,
    "k": 70,
    "status": "healthy",
    "time": ""
}

# =========================================================
# SENSOR SIMULATOR
# =========================================================
current_n = 70
current_p = 70
current_k = 70

def read_npk_simulated():

    global current_n
    global current_p
    global current_k

    mode = random.choice([
        "healthy",
        "low_n",
        "low_p",
        "low_k"
    ])

    # -----------------------------------------
    # HEALTHY
    # -----------------------------------------
    if mode == "healthy":

        current_n += random.randint(-3, 3)
        current_p += random.randint(-3, 3)
        current_k += random.randint(-3, 3)

        status = "Healthy"

    # -----------------------------------------
    # LOW NITROGEN
    # -----------------------------------------
    elif mode == "low_n":

        current_n = random.randint(5, 20)
        current_p = random.randint(60, 90)
        current_k = random.randint(60, 90)

        status = "Nitrogen Deficient"

    # -----------------------------------------
    # LOW PHOSPHORUS
    # -----------------------------------------
    elif mode == "low_p":

        current_n = random.randint(60, 90)
        current_p = random.randint(5, 20)
        current_k = random.randint(60, 90)

        status = "Phosphorus Deficient"

    # -----------------------------------------
    # LOW POTASSIUM
    # -----------------------------------------
    elif mode == "low_k":

        current_n = random.randint(60, 90)
        current_p = random.randint(60, 90)
        current_k = random.randint(5, 20)

        status = "Potassium Deficient"

    current_n = max(0, min(100, current_n))
    current_p = max(0, min(100, current_p))
    current_k = max(0, min(100, current_k))

    return {
        "n": current_n,
        "p": current_p,
        "k": current_k,
        "status": status,
        "time": datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    }

# =========================================================
# BROADCAST SENSOR
# =========================================================
async def broadcast(data: dict):

    disconnected = []

    for ws in clients:

        try:
            await ws.send_json(data)

        except:
            disconnected.append(ws)

    for ws in disconnected:
        clients.discard(ws)

# =========================================================
# LIVE SENSOR LOOP
# =========================================================
async def sensor_loop():

    global latest_sensor

    while True:

        latest_sensor = read_npk_simulated()

        print("\n==============================")
        print("🌱 LIVE SENSOR UPDATE")
        print("==============================")
        print(latest_sensor)

        await broadcast(latest_sensor)

        await asyncio.sleep(2)

# =========================================================
# LIFESPAN
# =========================================================
@asynccontextmanager
async def lifespan(app: FastAPI):

    task = asyncio.create_task(sensor_loop())

    yield

    task.cancel()

app.router.lifespan_context = lifespan

# =========================================================
# ROOT
# =========================================================
@app.get("/")
def root():

    return {
        "message": "HYBRID CNN + SENSOR SYSTEM RUNNING"
    }

# =========================================================
# SENSOR API
# =========================================================
@app.get("/sensor")
